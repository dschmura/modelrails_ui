<%= ui :table, caption: "Every column of the widget ledger", scroll: :horizontal do |t| %>
  <% t.with_toolbar do %>
    <p class="text-sm text-text-body">Stays put while the columns scroll</p>
    <a href="#" class="text-sm underline text-text-body focus-ring">Clear filters</a>
  <% end %>
  <% t.with_header do %>
    <% ["Name", "Owner", "Workspace", "Created", "Updated", "Status", "Revision", "Notes"].each do |label| %>
      <th scope="col" class="<%= UI::TableComponent::TH %>"><%= label %></th>
    <% end %>
  <% end %>
  <% t.with_body do %>
    <% 3.times do |i| %>
      <tr class="border-t border-border">
        <% ["Sprocket #{i + 1}", "Ada Lovelace", "Analytical Engine", "12 Mar", "2 hours ago", "Active", "r#{i + 41}", "No notes recorded"].each do |cell| %>
          <td class="px-4 py-3 whitespace-nowrap text-text-body"><%= cell %></td>
        <% end %>
      </tr>
    <% end %>
  <% end %>
  <% t.with_footer do %>
    <div class="border-t border-border px-4 py-3">Showing 1–3 of 3</div>
  <% end %>
<% end %>
