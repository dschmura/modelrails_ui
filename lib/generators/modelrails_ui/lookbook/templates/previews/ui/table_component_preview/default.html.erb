<%= ui :table, caption: "Widgets in this workspace" do |t| %>
  <% t.with_header do %>
    <th scope="col" class="<%= UI::TableComponent::TH %>">Name</th>
    <th scope="col" class="<%= UI::TableComponent::TH %>">Owner</th>
    <th scope="col" class="<%= UI::TableComponent::TH %>">Updated</th>
  <% end %>
  <% t.with_body do %>
    <tr class="border-t border-border">
      <td class="px-4 py-3 text-text-body">Sprocket</td>
      <td class="px-4 py-3 text-text-body">Ada Lovelace</td>
      <td class="px-4 py-3 text-text-body">2 hours ago</td>
    </tr>
    <tr class="border-t border-border">
      <td class="px-4 py-3 text-text-body">Flywheel</td>
      <td class="px-4 py-3 text-text-body">Charles Babbage</td>
      <td class="px-4 py-3 text-text-body">Yesterday</td>
    </tr>
  <% end %>
<% end %>
