#!/usr/bin/env ruby
# frozen_string_literal: true

# Moves a component's header prose into docs/components/<name>.md and leaves the
# three-line pointer behind.
#   bin/migrate-component-header NAME...                       # gem templates + docs
#   bin/migrate-component-header --rewrite-only --root DIR --docs DIR NAME...
#       DIR holds NAME_component.rb (a host app's vendored copies); the doc is
#       not written, and the run aborts if the doc lacks any section the header
#       carries — port those lines into the gem doc first.
require "optparse"
require_relative "../lib/modelrails_ui/component_header/migrator"

H = ModelrailsUi::ComponentHeader
root = File.expand_path("../lib/generators/modelrails_ui/add/templates", __dir__)
docs = File.expand_path("../docs/components", __dir__)
rewrite_only = false
OptionParser.new do |o|
  o.on("--root DIR") { |d| root = File.expand_path(d) }
  o.on("--docs DIR") { |d| docs = File.expand_path(d) }
  o.on("--rewrite-only") { rewrite_only = true }
end.parse!
abort("usage: bin/migrate-component-header [--rewrite-only --root DIR --docs DIR] NAME...") if ARGV.empty?

ARGV.each do |name|
  source = Dir[File.join(root, name, "#{name}_component.rb.tt")].first || Dir[File.join(root, "#{name}_component.rb")].first
  abort("#{name}: no source under #{root}") unless source
  doc_path = File.join(docs, "#{H.doc_name(name)}.md")
  abort("#{name}: no doc at #{doc_path}") unless File.exist?(doc_path)

  lines = File.readlines(source)
  doc_text = File.read(doc_path)
  if rewrite_only && (block = H.locate(lines)) && !H.pointer?(block, doc: H.doc_name(name))
    missing = H::Migrator.missing_from_doc(block, doc_text)
    abort("#{name}: doc lacks #{missing.join(', ')} — port those lines into #{doc_path} first") if missing.any?
  end

  new_lines, new_doc = H::Migrator.migrate(name, lines, doc_text)
  File.write(source, new_lines.join)
  File.write(doc_path, new_doc) unless rewrite_only
  puts "#{name}: header → pointer#{rewrite_only ? '' : ', doc updated'}"
end
